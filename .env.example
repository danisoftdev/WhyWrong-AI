# AI_PROVIDER options: hybrid | rules | gemini | groq | mock
AI_PROVIDER=hybrid

# Google Gemini (free Flash-class tier — get key from aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq (free tier — get key from console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=

# AI behaviour
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=700
AI_USER_DAILY_LIMIT=40
AI_CACHE_TTL_HOURS=168

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whywrong
DB_USER=
DB_PASS=

# Application
APP_ENV=development
APP_URL=http://localhost:8000
APP_KEY=
SESSION_NAME=ww_session
CSRF_TOKEN_LENGTH=32

# Logging (none | file | syslog)
LOG_CHANNEL=file
LOG_PATH=../logs/app.log
