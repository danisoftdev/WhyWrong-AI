{
  "name": "whywrong/backend",
  "description": "WhyWrong AI PHP REST API",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ramsey/uuid": "^4.7",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "WhyWrong\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WhyWrong\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit tests/",
    "migrate": "php scripts/migrate.php",
    "seed": "php scripts/seed.php"
  }
}
