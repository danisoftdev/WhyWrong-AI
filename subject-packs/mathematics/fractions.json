{
  "subject": "mathematics",
  "topic": "fractions",
  "version": "1.0.0",
  "misconceptions": [
    {
      "id": "misc-frac-add-across",
      "label": "Add tops, add bottoms",
      "explanation": "Adding numerators together and denominators together as independent whole numbers (e.g. 1/3 + 1/4 = 2/7).",
      "detector": {
        "type": "fraction_add_across",
        "pattern": "\\b(\\d+)/(\\d+)\\s*\\+\\s*(\\d+)/(\\d+)\\s*=\\s*(\\d+)/(\\d+)\\b"
      },
      "counterexample": {
        "statement": "If you eat 1/2 of a small pizza and 1/2 of another small pizza, you have eaten 1 whole pizza (2/2), NOT 2/4 (which is half a pizza)!",
        "analogy": "Adding fractions means combining parts of a whole, not adding raw pieces."
      },
      "worked_contrast": {
        "incorrect_rule": "1/3 + 1/4 = (1+1)/(3+4) = 2/7",
        "correct_rule": "1/3 + 1/4 = 4/12 + 3/12 = 7/12",
        "explanation": "Before combining parts, slices must be equal in size. Find the common denominator (12) first."
      },
      "probes": [
        {
          "id": "probe-frac-01",
          "prompt": "If you calculate 1/5 + 1/10, what would you get?",
          "options": [
            { "id": "p-opt-a", "text": "2/15", "is_predicted_wrong": true },
            { "id": "p-opt-b", "text": "3/10", "is_correct": true },
            { "id": "p-opt-c", "text": "2/10", "is_predicted_wrong": false },
            { "id": "p-opt-d", "text": "I'm not sure", "is_unsure": true }
          ],
          "predicted_wrong": "2/15",
          "rationale": "If the student chooses 2/15, it confirms the rule (1+1)/(5+10) = 2/15."
        },
        {
          "id": "probe-frac-02",
          "prompt": "What is 1/2 + 1/2?",
          "options": [
            { "id": "p-opt-a", "text": "2/4 (which equals 1/2)", "is_predicted_wrong": true },
            { "id": "p-opt-b", "text": "1 (or 2/2)", "is_correct": true },
            { "id": "p-opt-c", "text": "1/4", "is_predicted_wrong": false },
            { "id": "p-opt-d", "text": "I'm not sure", "is_unsure": true }
          ],
          "predicted_wrong": "2/4 (which equals 1/2)",
          "rationale": "A stark contradiction: adding two halves cannot equal one half."
        }
      ],
      "practice_questions": [
        {
          "id": "prac-frac-01",
          "prompt": "Calculate 1/4 + 1/2 using common denominators:",
          "options": ["2/6", "3/4", "2/4", "1/6"],
          "correct": "3/4"
        },
        {
          "id": "prac-frac-02",
          "prompt": "Calculate 2/5 + 1/10:",
          "options": ["3/15", "5/10 (1/2)", "3/10", "2/15"],
          "correct": "5/10 (1/2)"
        },
        {
          "id": "prac-frac-03",
          "prompt": "Calculate 1/3 + 1/6:",
          "options": ["2/9", "3/6 (1/2)", "2/6", "1/9"],
          "correct": "3/6 (1/2)"
        }
      ]
    },
    {
      "id": "misc-frac-larger-denom-larger",
      "label": "Larger denominator means larger fraction",
      "explanation": "Assuming 1/8 is larger than 1/4 because 8 is larger than 4.",
      "detector": {
        "type": "comparison",
        "pattern": "1/8\\s*>\\s*1/4"
      },
      "counterexample": {
        "statement": "If a cake is cut into 8 slices, each slice is much smaller than if cut into only 4 slices!",
        "analogy": "The denominator tells you how many pieces the whole is divided into. More pieces means smaller pieces."
      },
      "worked_contrast": {
        "incorrect_rule": "8 > 4 so 1/8 > 1/4",
        "correct_rule": "1/4 = 2/8, so 1/4 is twice as large as 1/8",
        "explanation": "As the denominator grows, the unit fraction shrinks."
      },
      "probes": [
        {
          "id": "probe-denom-01",
          "prompt": "Which fraction represents the largest amount?",
          "options": [
            { "id": "pd-opt-a", "text": "1/10", "is_predicted_wrong": true },
            { "id": "pd-opt-b", "text": "1/2", "is_correct": true },
            { "id": "pd-opt-c", "text": "1/5", "is_predicted_wrong": false },
            { "id": "pd-opt-d", "text": "I'm not sure", "is_unsure": true }
          ],
          "predicted_wrong": "1/10",
          "rationale": "Selecting 1/10 confirms treating denominators like regular whole integers."
        }
      ],
      "practice_questions": [
        {
          "id": "prac-denom-01",
          "prompt": "Order from smallest to largest: 1/3, 1/12, 1/6",
          "options": ["1/12, 1/6, 1/3", "1/3, 1/6, 1/12", "1/6, 1/12, 1/3", "1/12, 1/3, 1/6"],
          "correct": "1/12, 1/6, 1/3"
        }
      ]
    }
  ],
  "questions": [
    {
      "id": "q-math-frac-01",
      "prompt": "\\frac{1}{3} + \\frac{1}{4} = ?",
      "prompt_type": "katex",
      "difficulty": 2,
      "options": [
        { "id": "opt-a", "text": "\\frac{7}{12}", "is_correct": true },
        { "id": "opt-b", "text": "\\frac{2}{7}", "misconception_id": "misc-frac-add-across" },
        { "id": "opt-c", "text": "\\frac{2}{12}", "misconception_id": null },
        { "id": "opt-d", "text": "\\frac{5}{12}", "misconception_id": null }
      ],
      "correct_answer": "opt-a",
      "distractor_map": {
        "opt-b": "misc-frac-add-across"
      }
    },
    {
      "id": "q-math-frac-02",
      "prompt": "Which comparison is TRUE?",
      "prompt_type": "text",
      "difficulty": 1,
      "options": [
        { "id": "opt-a", "text": "1/8 > 1/4", "misconception_id": "misc-frac-larger-denom-larger" },
        { "id": "opt-b", "text": "1/4 > 1/8", "is_correct": true },
        { "id": "opt-c", "text": "1/8 = 1/4", "misconception_id": null },
        { "id": "opt-d", "text": "1/10 > 1/5", "misconception_id": "misc-frac-larger-denom-larger" }
      ],
      "correct_answer": "opt-b",
      "distractor_map": {
        "opt-a": "misc-frac-larger-denom-larger",
        "opt-d": "misc-frac-larger-denom-larger"
      }
    }
  ]
}
